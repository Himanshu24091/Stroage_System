# ==============================================================================
# STEALTH CLOUD VAULT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Session Security
SECRET_KEY=your-super-secret-random-key-here-12345

# Authentication Toggle (Option 3):
# Set to 'False' for direct 1-click open without any login screen.
# Set to 'True' to protect the vault with a Master PIN.
ENABLE_AUTH=False

# Master Security PIN (used when ENABLE_AUTH=True)
MASTER_PIN=1234

# Database Connection:
# Leave empty or set to sqlite:///vault.db for local SQLite.
# On Render / Railway, this will automatically be populated with PostgreSQL URL.
DATABASE_URL=sqlite:///vault.db

# Google Apps Script Web App Webhook URL (Optional bridge for direct Drive upload/delete)
# Paste your deployed Apps Script URL (e.g. https://script.google.com/macros/s/.../exec)
GAS_WEBHOOK_URL=

# Port configuration (Render / Railway injects PORT automatically)
PORT=5000
FLASK_ENV=development
